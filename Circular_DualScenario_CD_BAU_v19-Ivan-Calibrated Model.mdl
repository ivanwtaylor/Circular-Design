	~	Dmnl
	~		|

PERFORMANCE DECAY RATE=
	0.0154464
	~	1/Year
	~		|

PERFORMANCE GAIN=
	0.0119512
	~	Dmnl
	~		|

PERFORMANCE WEIGHT=
	2.24239
	~	Dmnl
	~		|

Performance= INTEG (
	performance improvement-performance decay,
		INITIAL PERFORMANCE)
	~	Dmnl
	~		|

performance data=
	Market Adoption*DATA PER USER
	~	Dmnl/Year
	~		|

performance decay=
	Performance*PERFORMANCE DECAY RATE
	~	Dmnl/Year
	~		|

performance effect on adoption=
	MIN(1, Performance^PERFORMANCE WEIGHT)
	~	Dmnl
	~		|

pressure for systemic change=
