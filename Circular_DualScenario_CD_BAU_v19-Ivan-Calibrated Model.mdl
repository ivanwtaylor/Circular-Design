{UTF-8}
LEARNING RATE=
	0.0795578
	~	Dmnl
	~		|

manufacturing cost adjustment=
	MANUFACTURING COST CHANGE RATE* MIN(maximum price, MAX(minimum price, manufacturing cost factor\
		))
	~	Dollars/(Year*Units)
	~		|

R and D investment=
	R AND D BASE+R AND D PROFIT SENSITIVITY*MAX(0, profit )+R AND D PRESSURE SENSITIVITY\
		*pressure for systemic change
	~	Dollars/Year
	~		|

R AND D NORMAL=
	DELAY1I(BAU R AND D NORMAL+STEP(BAU R AND D NORMAL*(SENSITIVITY ANALYSIS MULTIPLIER-\
		1), IMPLEMENTATION DATE ), IMPLEMENTATION TIME
	 , BAU R AND D NORMAL )
	~	Dollars/Year
	~		|

annual profit=
	profit
	~	Dollars/Year
	~		|

R AND D PROFIT SENSITIVITY=
	DELAY1I(BAU R AND D PROFIT SENSITIVITY+STEP(BAU R AND D PROFIT SENSITIVITY*(SENSITIVITY ANALYSIS MULTIPLIER\
		-1), IMPLEMENTATION DATE
	 ), IMPLEMENTATION TIME , BAU R AND D PROFIT SENSITIVITY )
	~	Dmnl
	~		|

r and d push=
	R and D investment/(R AND D NORMAL+R and D investment)
	~	Dmnl
	~		|

SENSITIVITY ANALYSIS MULTIPLIER=
	1
	~	Dmnl
	~		|

REFILL INCENTIVE EFFECT=
	DELAY1I(BAU REFILL INCENTIVE EFFECT+STEP(BAU REFILL INCENTIVE EFFECT*(SENSITIVITY ANALYSIS MULTIPLIER\
		-1), IMPLEMENTATION DATE
	 ), IMPLEMENTATION TIME , BAU REFILL INCENTIVE EFFECT )
	~	Dmnl
	~		|

RECOVERY DECAY RATE=
	DELAY1I(BAU RECOVERY DECAY RATE+STEP(BAU RECOVERY DECAY RATE*(SENSITIVITY ANALYSIS MULTIPLIER\
		-1), IMPLEMENTATION DATE )
	, IMPLEMENTATION TIME , BAU RECOVERY DECAY RATE )
	~	1/Year
	~		|

circular design build=
	CIRCULAR DESIGN GAIN * (design upgrades norm + r and d push) * (1 - Circular Design)
	~	Dmnl/Year
	~		|

BAU CIRCULAR DESIGN DECAY RATE=
	0.0112563
	~	1/Year
	~		|

recovery decay=
	Material Recovery*RECOVERY DECAY RATE
	~	Dmnl/Year
	~		|

desired capital investment=
	MAX(0,profit*INVEST FRACTION)
	~	Dollars/Year
	~		|

RECOVERY GAIN=
	DELAY1I(BAU RECOVERY GAIN+STEP(BAU RECOVERY GAIN*(SENSITIVITY ANALYSIS MULTIPLIER-1)\
		, IMPLEMENTATION DATE ), IMPLEMENTATION TIME
	 , BAU RECOVERY GAIN )
	~	1/Year
	~		|

INVEST FRACTION=
	DELAY1I(BAU INVEST FRACTION+STEP(BAU INVEST FRACTION*(SENSITIVITY ANALYSIS MULTIPLIER\
		-1), IMPLEMENTATION DATE ), IMPLEMENTATION TIME
	 , BAU INVEST FRACTION )
	~	Dmnl
	~		|

IMPLEMENTATION TIME=
	10
	~	Year
	~		|

Retained Earnings= INTEG (
	annual profit,
		INITIAL RETAINED EARNINGS)
	~	Dollars
	~		|

IMPLEMENTATION DATE=
	2025
	~	Year
	~		|

up front customers costs=
	BASE UPFRONT*Price/BASE PRICE* (1 - REFILL INCENTIVE EFFECT*MIN( 1, refillable packaging adoption\
		))
	~	Dollars/Units
	~		|

CIRCULAR DESIGN DECAY RATE=
	DELAY1I(BAU CIRCULAR DESIGN DECAY RATE+STEP(BAU CIRCULAR DESIGN DECAY RATE*(SENSITIVITY ANALYSIS MULTIPLIER\
		-1), IMPLEMENTATION DATE
	 ), IMPLEMENTATION TIME , BAU CIRCULAR DESIGN DECAY RATE)
	~	1/Year
	~		|

CIRCULAR DESIGN GAIN=
	DELAY1I(BAU CIRCULAR DESIGN GAIN+STEP(BAU CIRCULAR DESIGN GAIN*(SENSITIVITY ANALYSIS MULTIPLIER\
		-1), IMPLEMENTATION DATE
	 ), IMPLEMENTATION TIME , BAU CIRCULAR DESIGN GAIN )
	~	1/Year
	~		|

recovery build=
	RECOVERY GAIN*Circular Design*(1-Material Recovery)
	~	Dmnl/Year
	~		|

circular design decay=
	Circular Design*CIRCULAR DESIGN DECAY RATE
	~	Dmnl/Year
	~		|

manufacturing costs=
	MAX(BASE COST*BASE COST MULTIPLER, (BASE COST*(1-LEARNING RATE*LN(1+market adoption index\
		))+raw material cost addition
	))
	~	Dollars/Units
	~		|

INITIAL RETAINED EARNINGS=
	0
	~	Dollars
	~		|

R AND D PRESSURE SENSITIVITY=
	DELAY1I(BAU R AND D PRESSURE SENSITIVITY+STEP(BAU R AND D PRESSURE SENSITIVITY*(SENSITIVITY ANALYSIS MULTIPLIER\
		-1), IMPLEMENTATION DATE
	 ), IMPLEMENTATION TIME , BAU R AND D PRESSURE SENSITIVITY )
	~	Dollars/Year
	~		|

VIRGIN EMISSIONS PER TON=
	2.00017
	~	Tons CO2/Tons
	~		|

INITIAL CUMULATIVE CO2 EMISSIONS=
	0
	~	Tons CO2
	~		|

RECOVERED EMISSIONS PER TON=
	0.67946
	~	Tons CO2/Tons
	~		|

recovered material demand=
	Performance*total material demand
	~	Tons/Year
	~		|

total material demand=
	sales*VIRGIN PER UNIT
	~	Tons/Year
	~		|

CO2 emissions per year=
	recovered material demand*RECOVERED EMISSIONS PER TON+virgin material demand*VIRGIN EMISSIONS PER TON
	~	Tons CO2/Year
	~		|

Cumulative CO2 Emissions= INTEG (
	CO2 emissions per year,
		INITIAL CUMULATIVE CO2 EMISSIONS)
	~	Tons CO2
	~		|

adoption rate=
	ADOPTION SENSITIVITY *( performance effect on adoption) * affordability*(BASE PRICE/\
		Price)^DEMAND PRICE ELASTICITY* ((POTENTIAL MARKET
	- Market Adoption)/ADOPTION TIME
	)
	~	Customers/Year
	~		|

RAW MATERIAL PRICE SENS=
	0.0507216
	~	Dmnl
	~		|

maximum price=
	MAXIMUM PRICE MULTIPLER*BASE PRICE
	~	Dollars/Units
	~		|

MAXIMUM PRICE MULTIPLER=
	1.52813
	~	Dmnl
	~		|

revenue=
	sales*Price
	~	Dollars/Year
	~		|

minimum price=
	MINIMUM PRICE MULTIPLER*BASE PRICE
	~	Dollars/Units
	~		|

MINIMUM PRICE MULTIPLER=
	0.924867
	~	Dmnl
	~		|

PRICE ADJUSTMENT RATE=
	0.592972
	~	1/Year
	~		|

raw material prices=
	BASE RAW MATERIAL PRICES*(1+RAW MATERIAL PRICE SENS*LN(1+(virgin material demand/BASELINE VIRGIN DEMAND\
		)))
	~	Dollars/Tons
	~		|

price outflow=
	Price*PRICE OUTFLOW RATE
	~	Dollars/(Year*Units)
	~		|

PRICE OUTFLOW RATE=
	1.18456
	~	1/Year
	~		|

Price= INTEG (
	manufacturing cost adjustment+price ajustment-price outflow,
		BASE PRICE)
	~	Dollars/Units
	~		|

manufacturing cost factor=
	manufacturing costs*DEMAND PRICE ELASTICITY/(DEMAND PRICE ELASTICITY-1)
	~	Dollars/Units
	~		|

price ajustment=
	Price*PRICE ADJUSTMENT RATE
	~	Dollars/(Year*Units)
	~		|

MANUFACTURING COST CHANGE RATE=
	0.361219
	~	1/Year
	~		|

refillable packaging adoption=
	MIN(1, Capital Investment/(CAPITAL NORM + Capital Investment))
	~	Dmnl
	~		|

affordability=
	1/(1+up front customers costs/COST NORM)
	~	Dmnl
	~		|

BASE PRICE=
	455.834
	~	Dollars/Units
	~		|

BASE COST MULTIPLER=
	0.298979
	~	Dmnl
	~		|

DEMAND PRICE ELASTICITY=
	2.86411
	~	Dmnl
	~		|

MATERIAL COST SHARE=
	0.269673
	~	Tons/Units
	~	Share of raw material costs in unit cost
	|

BASE RAW MATERIAL PRICES=
	89.9699
	~	Dollars/Tons
	~	Reference price
	|

BASE UPFRONT=
	188.773
	~	Dollars/Units
	~	Baseline up-front customer cost
	|

BASELINE VIRGIN DEMAND=
	100.482
	~	Tons/Year
	~	Reference demand
	|

Capital Investment= INTEG (
	change in capital investment,
		INITIAL CAPITAL INVESTMENT)
	~	Dollars/Year
	~		|

CAPITAL NORM=
	796.285
	~	Dollars/Year
	~	Scale for leasing availability
	|

change in capital investment=
	(desired capital investment-Capital Investment)/INVEST DELAY
	~	Dollars/Year/Year
	~		|

change in inter firm trust=
	(desired inter firm trust-Inter Firm Trust)/TRUST DELAY
	~	Dmnl/Year
	~		|

sales=
	adoption rate*UNITS PER CUSTOMER*customer satisfaction
	~	Units/Year
	~		|

TRUST BASE=
	0.2
	~	Dmnl
	~	Baseline trust
	|

TRUST DELAY=
	5
	~	Year
	~		|

Inter Firm Trust= INTEG (
	change in inter firm trust,
		TRUST BASE)
	~	Dmnl
	~		|

COOP BASE=
	0.1
	~	Dmnl
	~	Baseline cooperation
	|

COOP TRUST SENS=
	0.799858
	~	Dmnl
	~	Sensitivity of cooperation to trust
	|

cooperation in logistics=
	COOP BASE + COOP TRUST SENS*Inter Firm Trust
	~	Dmnl
	~	Collaboration proxy driven by trust
	|

COST NORM=
	1057.76
	~	Dollars/Units
	~	Scaling for affordability
	|

INITIAL CAPITAL INVESTMENT=
	0
	~	Dollars/Year
	~		|

raw material cost addition=
	MATERIAL COST SHARE*raw material prices
	~	Dollars/Units
	~	Adds a materials component to unit cost
	|

TRUST SENSITIVITY TO PROFIT=
	0.599728
	~	Dmnl
	~	Trust sensitivity to profit
	|

desired inter firm trust=
	TRUST BASE + TRUST SENSITIVITY TO PROFIT * MIN(1, MAX(0, profit)/PROFIT NORM)
	~	Dmnl
	~		|

virgin material demand=
	sales*VIRGIN PER UNIT*(1-Material Recovery)
	~	Tons/Year
	~		|

BAU REFILL INCENTIVE EFFECT=
	0.4998
	~	Dmnl
	~	Max fractional reduction in up-front cost
	|

BAU INVEST FRACTION=
	0.00149599
	~	Dmnl
	~	Share of profit invested
	|

INVEST DELAY=
	0.500737
	~	Year
	~		|

VIRGIN PER UNIT=
	0.994115
	~	Tons/Units
	~	Virgin tonnage per unit sold
	|

PROFIT NORM=
	1000
	~	Dollars/Year
	~	Profit scale for normalization
	|

profit=
	revenue-sales*manufacturing costs
	~	Dollars/Year
	~		|

performance improvement=
	PERFORMANCE GAIN*design upgrades*(1-Performance)
	~	Dmnl/Year
	~		|

market adoption index=
	Market Adoption/INITIAL MARKET ADOPTION
	~	Dmnl
	~		|

ADOPTION SENSITIVITY=
	1.43663
	~	Dmnl
	~		|

ADOPTION TIME=
	7.49081
	~	Year
	~		|

AVERAGE LIFE=
	0.892903
	~	Year
	~		|

BASE COST=
	252.231
	~	Dollars/Units
	~		|

BAU CIRCULAR DESIGN GAIN=
	0.0188517
	~	1/Year
	~		|

Circular Design= INTEG (
	circular design build-circular design decay,
		INITIAL CIRCULAR DESIGN)
	~	Dmnl
	~		|

customer satisfaction=
	Performance
	~	Dmnl
	~		|

DATA PER USER=
	2.10134
	~	Dmnl/(Customers*Year)
	~		|

design upgrades=
	DESIGN UPGRADE GAIN*performance data
	~	Dmnl/Year
	~		|

design upgrades norm=
	design upgrades/(DESIGN UPGRADE REFERENCE+design upgrades)
	~	Dmnl
	~		|

DESIGN UPGRADE GAIN=
	0.000842948
	~	Dmnl
	~		|

DESIGN UPGRADE REFERENCE=
	1.57138
	~	Dmnl/Year
	~		|

ECO EFFICIENCY BASE=
	0.199904
	~	Dmnl
	~		|

eco efficiency=
	ECO EFFICIENCY BASE+ECO EFFICIENCY SENSITIVITY*Material Recovery
	~	Dmnl
	~		|

ECO EFFICIENCY SENSITIVITY=
	0.800143
	~	Dmnl
	~		|

INITIAL CIRCULAR DESIGN=
	0.025
	~	Dmnl
	~		|

